//! What Claude has actually typed into Bash — not a shell.
//!
//! Grown from a grammar too small, one construct at a time, each one added
//! because `cargo run --bin shell-report` said it was the biggest thing failing.
//! Restrictive on purpose: a grammar that accepts everything tells you nothing
//! about what it read.
//!
//! Coverage over 83,940 distinct commands, by round:
//!   1 words + quotes + `; && || |`         42.5%
//!   2 redirections, comments, `\`-newline  84.1%
//!   3 heredocs, `$( )`, backticks          94.2%
//!   4 `&`, groups, escapes, `name() {}`    96.7%
//!   5 atomic quoting, process substitution 99.5%
//!   6 `$(( ))`, brace expansion            99.7%
//!   7 `case … esac`, a compound after `do` 99.9%

script = { SOI ~ term* ~ (pipeline ~ term+)* ~ pipeline? ~ EOI }

pipeline = { command ~ ("|" ~ !"|" ~ command)* }
// Words, redirections and compounds in any order: `> out cat f` is as legal as
// `cat f > out`, and the corpus writes both.
//
// ⚠ **The compounds sit INSIDE the run rather than in front of it**, because a
// loop keyword is an ordinary word to this grammar: `for f in …; do case "$f" in
// …` and `for p in …; do (nc -z $ip $p) ; done` each put `do` and the compound
// in ONE command. While they were reachable only at the start of a command,
// neither was ever tried — which was both the corpus's commonest `case` and most
// of what the failure report filed under "subshell / grouping".
//
// The order within the run is load-bearing twice over. `case_stmt` goes before
// `word` so the keyword is not eaten as one. `group` goes AFTER it, so
// `{home,thoth,life}/android` is one brace-expanded word and only
// `{ echo DONE; }` is a group: a brace-expansion word cannot contain whitespace,
// so the group form fails the word rule and falls through. The trailing
// `group ~ redirect*` is reachable only when the run matched nothing at all.
command = { func_def | (redirect | case_stmt | word | group)+ ~ redirect* | group ~ redirect* }

// `name() { …; }`. Rare, but without it the empty `()` reads as a subshell
// containing nothing and the whole command fails.
func_def = { word ~ "(" ~ ")" ~ group }

// `( … )` and `{ …; }` group commands: `{ echo DONE; tail -f log; } &`.
//
// No space is required before the body. Demanding one looked right and could
// never match — pest already skips whitespace between sequence elements, so an
// explicit `WHITESPACE+` asks for a second space that is never there. Brace
// expansion stays whole because `bare` excludes braces only at a word's start.
group = { "(" ~ body ~ ")" | "{" ~ body ~ "}" }
body  = { term* ~ (pipeline ~ term+)* ~ pipeline? ~ term* }

// ---- case ----

// `case "$s" in completed*) break;; esac`.
//
// Every other compound — `for`, `while`, `if`, `until` — needs no rule at all:
// its keywords survive as ordinary words and the commands between them parse
// like any others, which is why this grammar can read a polling loop without
// knowing what a loop is. `case` is the one that cannot be waved through, and
// the reason is one character: `completed*)` closes a paren that was never
// opened, so the whole command dies at the FIRST arm and takes the loop around
// it with it. 126 of 366 unreadable commands, the largest bucket by three times
// (`reader/examples/unparsed-probe.rs`, 2026-08-15).
//
// ⚠ **The point is not the `case`.** It is almost always the CI/deploy wait —
// `for i in $(seq 1 40); do s=$(gh run view …); case "$s" in completed*) break;;
// esac; sleep 15; done` — so while this would not parse, every `ssh`, `kubectl`
// and file write in the loop around it was invisible to the miner.
case_stmt = { kw_case ~ word ~ kw_in ~ NEWLINE* ~ (case_arm ~ NEWLINE*)* ~ kw_esac }

// Keywords, and each needs its boundary checked: `case` here must not match the
// `case` in `cases.txt`, and `esac` must not match `esacinth`. Atomic, so the
// lookahead sits against the very next character rather than after pest's
// implicit whitespace skip — which would defeat both.
kw_case = @{ "case" ~ &(" " | "\t" | NEWLINE) }
kw_in   = @{ "in" ~ &(" " | "\t" | NEWLINE) }
kw_esac = @{ "esac" ~ !(ASCII_ALPHANUMERIC | "_" | "-" | ".") }

// `a|b) …;;`, with the optional opening paren bash also allows. The terminator
// is optional because the last arm may omit it: `case x in a) y; esac` is legal.
case_arm = { "("? ~ case_pattern ~ ("|" ~ case_pattern)* ~ ")" ~ case_body ~ case_end? }
// A glob, not a word: `*29778797*`, `project_irc_archive.md`, `completed*`.
// Nothing in it is a file — a pattern names what the subject might look like —
// so it is captured whole and never walked.
case_pattern = @{ (squoted | dquoted | !("|" | ")" | ";" | WHITESPACE | NEWLINE) ~ ANY)+ }

// The arm's commands. A copy of `body` for one reason: `body`'s `seq` would eat
// `;;` as two empty statements and run straight on into the next arm's pattern,
// so the separator has to refuse the terminator. `case_seq` is silent and yields
// the ordinary `seq` pair, so the walker reads an arm's separators with the same
// code as everywhere else.
//
// The `!kw_esac` guard is the other half: without it the last arm's body claims
// `esac` as a command and there is nothing left for the statement to close on.
case_body     = { case_term* ~ (case_pipeline ~ case_term+)* ~ case_pipeline? ~ case_term* }
case_pipeline = _{ !kw_esac ~ pipeline }
case_term     = _{ and_if | or_if | case_seq }
case_seq      = _{ !case_end ~ seq }
// `;&` and `;;&` fall through to the next arm; this grammar records what ran,
// and both of them ran, so the distinction costs nothing to ignore. Longest
// first, or `;;&` matches as `;;` and leaves a stray `&`.
case_end = _{ ";;&" | ";;" | ";&" }

// ---- redirection ----

redirect = { procsub | heredoc | herestring | fd_dup | file_redirect }

// A heredoc's BODY is removed before parsing (`strip_heredocs`): it is data —
// commit messages, Python, YAML — and reading prose as shell finds commands
// nobody ran. What is left here is the operator and its delimiter, which is all
// the shell part of a heredoc ever was.
heredoc = { ("<<-" | "<<") ~ !"<" ~ word }
// `<<<` is a here-string: its operand is a value, not a file, and has no body.
herestring = { "<<<" ~ word }
// `diff <(ls a) <(ls b)` — the inner commands run, so they are parsed like any
// other group rather than skipped.
procsub = { ("<(" | ">(") ~ body ~ ")" }
// `2>&1` and `&>` name a descriptor, not a file. Matched only so they stop
// being parse errors — they contribute no path.
fd_dup = { (ASCII_DIGIT* ~ ">" ~ ">"? | "&>" | ">&") ~ "&"? ~ ASCII_DIGIT+ }
// The direction is captured so a target can be classified without re-reading it.
file_redirect = { ASCII_DIGIT? ~ (append | write | read) ~ word }
append = { ">>" }
write  = { ">" }
read   = { "<" }

// ---- words ----

// Compound-atomic: adjacent runs are ONE word, so `--flag="a b"` and
// `"$HOME"/Code/x` do not split into two. No implicit whitespace inside.
word = ${ part+ }
part = _{ squoted | dquoted | arith | subst | backtick | empty_braces | brace_expand | bare }

// The quoting rules are ATOMIC, and that is load-bearing. Left non-atomic, pest
// inserts its implicit whitespace/comment skipping *inside* the string: a `#` in
// `nix develop "…/lares#android"` or in `sed 's#a#b#g'` then started a comment
// that swallowed the closing quote, and 2,058 commands failed for it.
squoted = @{ "'" ~ (!"'" ~ ANY)* ~ "'" }
dquoted = @{ "\"" ~ ("\\" ~ ANY | !"\"" ~ ANY)* ~ "\"" }

// `$( … )` and backticks run commands whose file use counts as much as any
// other, so the inner text is captured whole and parsed again. Nesting is
// handled by recursion: `$(dirname "$(readlink -f x)")`.
// `$(( … ))` is arithmetic, not a command, and must be matched before `$(` —
// otherwise the substitution rule stops at the first `)` and leaves the second
// dangling, which is what 216 `until [ $(( $(date +%s) - t0 )) -ge 10 ]` loops
// failed on. Nothing inside is a file, so the body is skipped whole.
arith      = ${ "$((" ~ arith_body ~ "))" }
arith_body = @{ (subst | !"))" ~ ANY)* }

subst         = ${ "$(" ~ subst_body ~ ")" }
subst_body    = @{ (subst | squoted | dquoted | !")" ~ ANY)* }
backtick      = ${ "`" ~ backtick_body ~ "`" }
backtick_body = @{ (!"`" ~ ANY)* }

// `find . -exec rm {} \;` — the placeholder is an argument, not a group.
empty_braces = @{ "{}" }

// Brace expansion — `{home,thoth,life}/android`, `dash/{config,state}`. It can
// hold no whitespace, which is exactly what separates it from a brace *group*
// and lets the two share an opening character without ambiguity.
brace_expand = @{ "{" ~ (!("}" | WHITESPACE | NEWLINE) ~ ANY)+ ~ "}" }

// A bare word runs until whitespace or an operator. A backslash escapes the next
// character, which is how `find . \( -name x \)` gets its parens past the shell.
bare    = @{ !opener ~ (escaped | !(WHITESPACE | NEWLINE | operator | "'" | "\"" | "`") ~ ANY)+ }
escaped = _{ "\\" ~ !NEWLINE ~ ANY }

opener   = _{ "{" | "}" | "(" | ")" }
operator = _{ "|" | "&" | ";" | "(" | ")" | "<" | ">" | "$(" }

// `&` ends a command by backgrounding it: `nohup … > log 2>&1 &`. The fd forms
// are matched before this by `fd_dup`.
//
// The separator is KEPT, unlike every other punctuation here, because it is the
// only thing in the text that says whether the command after it ran: `a; b` runs
// both whatever happens, `a && b` runs `b` only if `a` worked. `term` stays
// silent and its three alternatives carry the meaning — see `shell::Reached`.
// `and_if` must precede `seq`, or `&&` matches as a background `&`.
term   = _{ and_if | or_if | seq }
and_if = { "&&" }
or_if  = { "||" }
seq    = { ";" | "&" | NEWLINE }

WHITESPACE = _{ " " | "\t" | line_continuation }
// A backslash-newline joins two lines into one command.
line_continuation = _{ "\\" ~ NEWLINE }
// A comment runs to end of line. Trivia, so it may appear anywhere a space can —
// which is where the corpus puts it, including on its own line mid-script.
COMMENT = _{ "#" ~ (!NEWLINE ~ ANY)* }
