#!/usr/bin/env bash
# Starts the gate, which keeps its own results and failure ledger
# (~/.cache/dev-lint-gate/failures.jsonl), after this repository's one own check.
set -euo pipefail

# Whose work is staged, before the long gate: `git commit` takes the whole index,
# so another session's staging ships under your message. A hook, not a gate row:
# it only warns (two sessions may edit one file), and the gate shows a passing
# row's output to nobody. This repo's own build first, by a relative path (hooks
# run at the toplevel), so a rebuilt check applies at once.
STAGED_CHECK="target/release/staged-check"
[[ -x $STAGED_CHECK ]] || STAGED_CHECK="$HOME/.local/bin/staged-check"
if [[ -x $STAGED_CHECK ]]; then
  # staged-check resolves the record's spelling of this directory itself.
  git diff --cached --name-only | "$STAGED_CHECK" "$(pwd)" || true
else
  echo "⚠ staged-check not built — whose-work-is-staged check SKIPPED, not passed." >&2
  echo "  build it: nix develop -c cargo build --release --bin staged-check" >&2
fi

exec nix run "git+file:../dev-lint?ref=HEAD#gate" -- . gate.json
