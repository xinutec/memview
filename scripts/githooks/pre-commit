#!/usr/bin/env bash
# Single health gate. A commit must be healthy: this runs the full gate
# (gate.json, rendered from gate.dhall) — backend + frontend + layout harness +
# the corpus lint + shared dev-lint rules. There is NO separate pre-push step.
# Slow by design; we optimise for healthy commits, not commit speed.
# Quiet on success: the gate prints a check's output only when it FAILS, so a
# healthy commit isn't buried under build/test noise (DL-GIT-PRECOMMIT-GATE).
# Bypass a genuine work-in-progress commit with:  git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# ⚠ **Whose work is in the index — FIRST, before the nine-minute gate.** `git
# commit` takes the whole INDEX, so `git add <paths>` does not protect you: a
# session staging between your add and your commit ships their work under your
# message (memview#1258). Running it first means you can stop and unstage
# instead of finding out after the gate.
#
# ⚠ **A HOOK, not a gate row.** The gate prints a check's output only when it
# FAILS, and this one must never fail — two sessions legitimately edit one file
# and a refusal would wedge a shared repo. A warning inside a passing gate row
# is a warning nobody ever sees.
# ⚠ `$HOME`, never a literal home directory: this repo is public, and a hook
# welded to one machine's layout is a hook nobody else can run.
STAGED_CHECK="$HOME/Library/Caches/cargo/target/release/staged-check"
[[ -x $STAGED_CHECK ]] || STAGED_CHECK="$HOME/.local/bin/staged-check"
if [[ -x $STAGED_CHECK ]]; then
  # ⚠ It resolves the record's own spelling of this directory itself — see
  # `staged-check`'s `wrong_shape` handling. The hook only names where it is.
  git diff --cached --name-only | "$STAGED_CHECK" "$(pwd)" || true
else
  # ⚠ A silent skip is a check that reports nothing and looks clean.
  echo "⚠ staged-check not built — whose-work-is-staged check SKIPPED, not passed." >&2
  echo "  build it: nix develop -c cargo build --release --bin staged-check" >&2
fi

if ! out=$(nix run "git+file:../dev-lint?ref=HEAD#gate" -- . gate.json 2>&1); then
  printf '%s\n' "$out" >&2
  # ⚠ **A RECORD, not a check — memview#1396 asks a question nothing can answer
  # retrospectively.** That ticket says to measure how often a gate's only
  # failing finding lies OUTSIDE the staged set before changing what the gate is
  # entitled to fail on. Nothing logs a gate run: the output is captured into
  # `$out` and printed once, so there is no history to count and the working
  # trees that produced it are gone. This line is the whole instrument.
  #
  # ⚠ **The findings are stored RAW, deliberately.** The gate runs a dozen
  # checks whose output formats differ, so a path parser here would be a second
  # implementation of a dozen tools and would fail silently on the one that
  # mattered. A small sample read by hand beats a fragile count — the same
  # argument `dev-lint` makes for not inferring what it cannot see.
  #
  # ⚠ **It must not be able to break a commit that already failed.** Everything
  # below is guarded: the commit's verdict was decided on the line above.
  #
  # ⚠ **And the per-check LOGS are copied aside, because /tmp is swept daily
  # (memview#1243).** `$out` is the gate's summary; the diagnosis lives in the
  # per-check files it points at, under /tmp. That ticket's only open item is a
  # ui-check failure nobody has ever read, and its stated next step was "capture
  # the output BEFORE re-running" — a plan that depends on somebody being
  # unhurried at the one moment they are not. The instinct on a flaky failure is
  # to re-run, which destroys the only evidence. So it is taken automatically.
  { GATE_LOG="$HOME/.claude/memview/cache/gate-failures.jsonl"
    mkdir -p "$(dirname "$GATE_LOG")"
    STAGED=$(git diff --cached --name-only | jq -R . | jq -s -c .)
    # ⚠ `pwd -P`: the gate names its log directory from the PHYSICAL path, and
    # ~/Code/memview is a symlink onto /Volumes/Backup. The logical path finds
    # nothing and would fail silently, which is the shape of bug this whole
    # record exists to catch.
    SRC="/tmp/gate-log_$(pwd -P | sed 's|^/||; s|/|_|g')"
    KEEP=""
    if [ -d "$SRC" ]; then
      KEEP="$HOME/.claude/memview/cache/gate-logs/$(date -u +%Y%m%dT%H%M%SZ)"
      mkdir -p "$KEEP"
      # ⚠ `-p` keeps the MTIMES, and they are the point. The gate overwrites
      # only the checks that ran, so this directory holds logs from earlier
      # runs too — a reader tells this run's from the rest by time. Copying the
      # lot and preserving that is honest; guessing which check failed would
      # need a parser for a dozen output formats, which the note above already
      # refuses for the same reason.
      cp -Rp "$SRC"/. "$KEEP"/ 2>/dev/null
    fi
    # Not pruned. A snapshot is ~96 KB and a gate failure is rare; a cleanup
    # that deleted the evidence this exists to preserve would be the joke.
    jq -n -c --arg at "$(date -u +%FT%TZ)" --arg repo "$(pwd)" \
       --argjson staged "$STAGED" --arg out "$out" --arg logs "$KEEP" \
       '{at: $at, repo: $repo, staged: $staged, findings: $out, logs: $logs}' >> "$GATE_LOG"
  } 2>/dev/null || true
  exit 1
fi
