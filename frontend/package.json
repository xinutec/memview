    "@angular/material": "^22.0.3",
    "@angular/platform-browser": "^22.0.4",
    "@angular/router": "^22.0.4",
    "@fontsource/roboto": "^5.2.10",
    "@xinutec/ui-harness": "github:xinutec/ui-harness#36b57a265ef372a096d1413e90f2c0bd5cb31bd5",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.4",
    "@playwright/test": "^1.61.1",
    "angular-eslint": "^22.0.0",
    "esbuild": "^0.28.1",
