{
  "name": "memview-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "ng build && ng build console-web",
    "lint": "eslint src projects/*/src e2e projects/*/e2e playwright.config.ts projects/*/playwright*.config.ts",
    "ng": "ng",
    "prebuild": "node scripts/stamp-version.mjs",
    "prebuild:console": "node scripts/stamp-version.mjs",
    "prelint": "node scripts/stamp-version.mjs",
    "prestart": "node scripts/stamp-version.mjs",
    "pretest": "node scripts/stamp-version.mjs",
    "stamp": "node scripts/stamp-version.mjs",
    "start": "ng serve",
    "start:console": "ng serve console-web",
    "test": "ng test memview-web --watch=false && ng test console-web --watch=false",
    "ui-check": "playwright test && playwright test -c projects/console-web/playwright.config.ts",
    "sync-check": "playwright test -c projects/console-web/playwright.sync.config.ts",
    "watch": "ng build --watch --configuration development",
    "build:console": "ng build console-web",
    "publish:console": "pnpm run build:console && rsync -a dist/console-build/browser/ dist/console-live/ && node scripts/prune-live.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/material": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@angular/service-worker": "^22.1.7",
    "@fontsource/roboto": "^5.3.0",
    "@xinutec/ui-harness": "github:xinutec/ui-harness#fd31cb2613875bb3ba4f429a66cdacff8077b2f1",
    "marked": "^18.0.7",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "angular-eslint": "^22.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
