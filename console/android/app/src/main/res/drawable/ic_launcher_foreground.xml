    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- A shell prompt: a chevron and a caret. The console's whole thesis is that
         the thing on the other end is a command line, and the one mark everybody
         reads that way is `> _`.

         Solid white, no second tone: this same drawable is the <monochrome> layer
         for themed icons, where a tint would wash a second colour out anyway. The
         adaptive-icon safe zone is the middle 72 of 108, so nothing strays outside
         18..90. -->
    <path
        android:pathData="M38,40 L54,54 L38,68"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M62,68 L76,68"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round" />
</vector>
