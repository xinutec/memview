#!/bin/sh
# A stand-in for `claude -p --input-format stream-json --output-format stream-json`.
#
# It exists so the session machinery — spawn, streaming, sending, asking for
# permission, clean exit on stdin close — can be tested without spending a token
# or depending on the model being reachable. It understands only --session-id;
# the *protocol* is covered against a real capture in protocol.rs.

# `claude auth login`, as it runs with no terminal: the link, a prompt with no
# newline, and the code read from stdin. One code is accepted.
if [ "${1:-}" = auth ] && [ "${2:-}" = login ]; then
  echo "Opening browser to sign in…"
  echo "If the browser didn't open, visit: https://claude.com/cai/oauth/authorize?code=true&state=stub"
  printf 'Paste code here if prompted > '
  read -r code
  if [ "$code" = "good-code" ]; then
    echo "Login successful."
    exit 0
  fi
  echo "OAuth error: invalid code" >&2
  exit 1
fi

session="unknown"
# The session-so-far total, because that is what the CLI reports each time.
total=0
# What it was called and which conversation it was handed, for the one test that
# asks about the argument list rather than the protocol. `--resume` is read into
# a separate name so the init line keeps saying what it always said.
name=""
resumed=""
while [ $# -gt 0 ]; do
  case "$1" in
    --session-id) session="$2"; shift ;;
    --resume) resumed="$2"; shift ;;
    -n) name="$2"; shift ;;
  esac
  shift
done

# Unset everywhere else, so this leaves nothing behind in the tests that do not
# care. Written even when empty: absent and empty are different findings, and a
# test for a MISSING argument needs the file to exist.
if [ -n "${CONSOLE_STUB_ARGV:-}" ]; then
  printf '%s' "$name" > "$CONSOLE_STUB_ARGV/${resumed:-$session}.name"
fi

printf '{"type":"system","subtype":"init","model":"stub","cwd":"%s","tools":["Bash"],"session_id":"%s"}\n' \
  "$PWD" "$session"

# One reply per line of input, then exit 0 when stdin closes — the behaviour the
# runner relies on for a session that lives across many turns.
while IFS= read -r line; do
  case "$line" in
    # The console's first question, answered as the real CLI does: a control
    # response, no turn. Read as an instruction it would be acknowledged and
    # cost money, which no test expects of a session nobody has spoken to.
    *'"subtype":"initialize"'*)
      id=$(printf '%s' "$line" | sed -e 's/.*"request_id":"//' -e 's/".*//')
      printf '{"type":"control_response","response":{"subtype":"success","request_id":"%s","response":{"commands":[{"name":"effort","description":"Set effort level for model usage","argumentHint":"<low|medium|high|xhigh|max|auto>"}],"models":[],"available_output_styles":["default"]}}}\n' "$id"
      ;;
    # Taking back a message still in the queue, by its id, as the real CLI does
    # (`cancel_async_message`): cancelled while it waits, not once a turn took it.
    *'"subtype":"cancel_async_message"'*)
      id=$(printf '%s' "$line" | sed -e 's/.*"request_id":"//' -e 's/".*//')
      target=$(printf '%s' "$line" | sed -e 's/.*"message_uuid":"//' -e 's/".*//')
      case " $queued " in
        *" $target "*)
          queued=$(printf '%s' " $queued " | sed -e "s/ $target / /")
          printf '{"type":"control_response","response":{"subtype":"success","request_id":"%s","response":{"cancelled":true}}}\n' "$id"
          printf '{"type":"command_lifecycle","command_uuid":"%s","state":"cancelled","session_id":"%s"}\n' "$target" "$session"
          ;;
        *)
          # Not in the queue yet: answered false, and the cancel waits for the
          # message, which it takes out the moment it arrives.
          printf '{"type":"control_response","response":{"subtype":"success","request_id":"%s","response":{"cancelled":false}}}\n' "$id"
          case " $late " in
            *" $target "*)
              late=$(printf '%s' " $late " | sed -e "s/ $target / /")
              printf '{"type":"command_lifecycle","command_uuid":"%s","state":"queued","session_id":"%s"}\n' "$target" "$session"
              printf '{"type":"command_lifecycle","command_uuid":"%s","state":"cancelled","session_id":"%s"}\n' "$target" "$session"
              ;;
          esac
          ;;
      esac
      ;;
    # An ANSWER to the question below. It reports what it was told, which is what
    # lets a test drive a whole approval round trip and see the verdict land.
    *'"control_response"'*)
      case "$line" in
        # An answered question. What came back is reported rather than just the
        # verdict, because for `AskUserQuestion` the verdict is never the point:
        # approving it unchanged is exactly the bug this reports the absence of.
        # Only the first answer's value is read, which is all a single-choice
        # question has — the shape is pinned in protocol.rs instead.
        # Words instead of a choice. Reported first because that is the CLI's own
        # precedence: `response` wins over `answers`, which is why the two are
        # never sent together.
        # ⚠ Matched on `"response":"` — a STRING value. Every control response
        # carries a `"response":{` object of its own, so the bare key matches
        # every line there is, including a plain approval and a refusal.
        *'"response":"'*)
          said=$(printf '%s' "$line" | sed -e 's/.*"response":"//' -e 's/".*//')
          verdict="said $said"
          ;;
        *'"answers"'*)
          chose=$(printf '%s' "$line" | sed -e 's/.*"answers":{[^:]*:"//' -e 's/".*//')
          verdict="chose $chose"
          # A note rides WITH the choice rather than instead of it, so both are
          # reported — a stub that showed only one could not tell them apart.
          case "$line" in
            *'"notes":"'*)
              note=$(printf '%s' "$line" | sed -e 's/.*"notes":"//' -e 's/".*//')
              verdict="$verdict noting $note"
              ;;
          esac
          ;;
        # A note against a question nothing was picked for, which the CLI reports
        # as `(no option selected)` and still counts as an answer.
        *'"notes":"'*)
          note=$(printf '%s' "$line" | sed -e 's/.*"notes":"//' -e 's/".*//')
          verdict="noting $note"
          ;;
        *'"allow"'*) verdict="allowed" ;;
        *) verdict="refused" ;;
      esac
      printf '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"%s"}},"session_id":"%s"}\n' \
        "$verdict" "$session"
      printf '{"type":"result","subtype":"success","total_cost_usd":0,"num_turns":1,"duration_ms":1,"session_id":"%s"}\n' "$session"
      ;;
    # Work that is started and left running. The call comes straight back saying
    # so — and that answer, not the arguments it was given, is what the runner
    # counts; see `protocol::detached`. The notification below is the only signal
    # that it has finished.
    # A monitor, which declares its own deadline when it starts — here one
    # second — and whose closing notice never comes.
    *'watch it briefly'*)
      printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_mon","name":"Monitor","input":{"command":"tail -f log","description":"build log"}}]},"session_id":"%s"}\n' "$session"
      printf '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_mon","content":"Monitor started (task bmon1, expires in 1s unless the source ends first). You will be notified on each event."}]},"session_id":"%s"}\n' "$session"
      printf '{"type":"result","subtype":"success","total_cost_usd":0,"num_turns":1,"duration_ms":1,"session_id":"%s"}\n' "$session"
      ;;
    *'in the background'*)
      printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_bg","name":"Bash","input":{"command":"sleep 600","run_in_background":true}}]},"session_id":"%s"}\n' "$session"
      printf '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_bg","content":"Command running in background with ID: bh0ynhbpb"}]},"session_id":"%s"}\n' "$session"
      printf '{"type":"result","subtype":"success","total_cost_usd":0,"num_turns":1,"duration_ms":1,"session_id":"%s"}\n' "$session"
      ;;
    # Stopping one, which is the ending that reports nothing afterwards. The
    # answer comes back on the *stopping* call and names the task rather than the
    # call that started the work — so this is the last that is ever heard of
    # `toolu_bg`, and no notification follows.
    *'stop that'*)
      printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"tool_use","id":"toolu_stop","name":"TaskStop","input":{"taskId":"bh0ynhbpb"}}]},"session_id":"%s"}\n' "$session"
      printf '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_stop","content":"{\\"message\\":\\"Successfully stopped task: bh0ynhbpb (sleep 600)\\"}"}]},"session_id":"%s"}\n' "$session"
      printf '{"type":"result","subtype":"success","total_cost_usd":0,"num_turns":1,"duration_ms":1,"session_id":"%s"}\n' "$session"
      ;;
    # The harness reporting that one has finished, in its own shape: a user
    # message nobody typed, naming the call that started the work.
    *'that finished'*)
      printf '{"type":"user","message":{"role":"user","content":[{"type":"text","text":"<task-notification><tool-use-id>toolu_bg</tool-use-id><status>completed</status></task-notification>"}]},"session_id":"%s"}\n' "$session"
      printf '{"type":"result","subtype":"success","total_cost_usd":0,"num_turns":1,"duration_ms":1,"session_id":"%s"}\n' "$session"
      ;;
    # Work announced and then still going: a status line, and nothing after it.
    # A real session announces a status when it CHANGES and says nothing further
    # until the turn ends, which is what makes the console's own flag the only
    # record that anything is happening. Nothing here is written to a transcript.
    *'take a while'*)
      printf '{"type":"system","subtype":"status","status":"requesting","session_id":"%s"}\n' "$session"
      ;;
    # A turn that reports how full the context now is, the way every real
    # assistant message does. Its own instruction rather than a field on the
    # ordinary reply, because adding usage there would put a second `Text` in
    # front of every test that counts them.
    #
    # The numbers are shaped like life's: two tokens of input beside half a
    # million of cache, so anything reading `input_tokens` alone calls a full
    # conversation empty.
    *'say how full'*)
      printf '{"type":"assistant","message":{"role":"assistant","usage":{"input_tokens":2,"cache_creation_input_tokens":900,"cache_read_input_tokens":546967,"output_tokens":9},"content":[{"type":"text","text":"full"}]},"session_id":"%s"}\n' "$session"
      printf '{"type":"result","subtype":"success","total_cost_usd":0,"num_turns":1,"duration_ms":1,"session_id":"%s"}\n' "$session"
      ;;
    # A lapsed sign-in, as `claude -p --output-format stream-json` says it: a
    # synthetic message whose line carries the error, and a result with no cost.
    *'signed out'*)
      printf '{"type":"assistant","message":{"model":"<synthetic>","role":"assistant","usage":{"input_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":0},"content":[{"type":"text","text":"Login expired · Please run /login"}]},"error":"authentication_failed","is_api_error_message":true,"session_id":"%s"}\n' "$session"
      printf '{"type":"result","subtype":"success","is_error":true,"api_error_status":401,"total_cost_usd":%s,"num_turns":1,"duration_ms":1,"session_id":"%s"}\n' "$total" "$session"
      ;;
    # An instruction that wants the person's opinion rather than permission.
    # Gated by `can_use_tool` like any other tool, which is what lets a console
    # answer it at all — see `protocol::QUESTION_TOOL`.
    *'ask me'*)
      printf '{"type":"control_request","request_id":"ask-q","request":{"subtype":"can_use_tool","tool_name":"AskUserQuestion","display_name":"AskUserQuestion","input":{"questions":[{"question":"which way","header":"Way","multiSelect":false,"options":[{"label":"left","description":"go left"},{"label":"right","description":"go right"}]}]},"tool_use_id":"toolu_q"}}\n'
      ;;
    # An instruction that wants to run something dangerous: ask, and say nothing
    # more until answered — a real session blocks here too.
    *'may i'*)
      printf '{"type":"control_request","request_id":"ask-1","request":{"subtype":"can_use_tool","tool_name":"Bash","display_name":"Bash","input":{"command":"rm -rf /tmp/x"},"description":"delete a directory","tool_use_id":"toolu_stub"}}\n'
      ;;
    # Any other instruction: acknowledged, answered, done.
    #
    # total_cost_usd is CUMULATIVE, as the real CLI reports it — the running
    # total for the session, not the price of this exchange. The stub used to
    # repeat a flat 0.25, which quietly agreed with a reader that summed them,
    # so no test could see the difference.
    *)
      total=$(awk "BEGIN { printf \"%.2f\", $total + 0.25 }")
      # The replay carries back the words it was given, exactly as
      # `--replay-user-messages` does. It used to say a fixed "replayed", which
      # is indistinguishable from the real thing for a test that only asks
      # whether an echo arrived — and useless for one that asks WHICH message
      # was read, which is what tells a waiting message apart from a deaf
      # session.
      said=$(printf '%s' "$line" | sed -e 's/.*"text":"//' -e 's/".*//')
      # A client's id for the message, carried back on the echo. The real CLI
      # records one message per id: a second is echoed and neither recorded nor
      # answered (measured on 2.1.289, live and after --resume).
      # Without one, the CLI gives the message an id of its own.
      given=""
      case "$line" in
        *'"uuid":"'*) given=$(printf '%s' "$line" | sed -e 's/.*"uuid":"//' -e 's/".*//') ;;
      esac
      own=$((own + 1))
      uuid="${given:-00000000-0000-4000-8000-$(printf '%012d' "$own")}"
      # Words starting `queued:` wait in the queue, unread, as a message sent to a
      # busy session does: no echo until a turn takes it in, which here none does.
      case "$said" in
        queued:*)
          queued="$queued $uuid"
          printf '{"type":"command_lifecycle","command_uuid":"%s","state":"queued","session_id":"%s"}\n' "$uuid" "$session"
          continue
          ;;
        # Words starting `hooked:` go in the real CLI's order: started, then the
        # echo seconds later, once its hooks have run (measured on 2.1.289:
        # 1.8s with a UserPromptSubmit hook).
        hooked:*)
          printf '{"type":"command_lifecycle","command_uuid":"%s","state":"queued","session_id":"%s"}\n' "$uuid" "$session"
          printf '{"type":"command_lifecycle","command_uuid":"%s","state":"started","session_id":"%s"}\n' "$uuid" "$session"
          sleep 2
          printf '{"type":"user","uuid":"%s","isReplay":true,"message":{"role":"user","content":[{"type":"text","text":"%s"}]},"session_id":"%s"}\n' "$uuid" "$said" "$session"
          printf '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"ack"}},"session_id":"%s"}\n' "$session"
          printf '{"type":"result","subtype":"success","total_cost_usd":%s,"num_turns":1,"duration_ms":5,"session_id":"%s"}\n' "$total" "$session"
          printf '{"type":"command_lifecycle","command_uuid":"%s","state":"completed","session_id":"%s"}\n' "$uuid" "$session"
          continue
          ;;
        # Not yet read off stdin when a cancel for it comes: see the cancel above.
        late:*)
          late="$late $uuid"
          continue
          ;;
        # Delivered into a running turn: an attachment carrying the client's id as
        # `source_uuid`, read, and no echo of its own.
        fold:*)
          printf '{"type":"command_lifecycle","command_uuid":"%s","state":"queued","session_id":"%s"}\n' "$uuid" "$session"
          printf '{"type":"command_lifecycle","command_uuid":"%s","state":"started","session_id":"%s"}\n' "$uuid" "$session"
          printf '{"type":"attachment","attachment":{"type":"queued_command","prompt":[{"type":"text","text":"%s"}],"source_uuid":"%s","commandMode":"prompt"},"uuid":"00000000-0000-4000-9000-%012d","session_id":"%s"}\n' "$said" "$uuid" "$own" "$session"
          printf '{"type":"result","subtype":"success","total_cost_usd":0,"num_turns":1,"duration_ms":1,"session_id":"%s"}\n' "$session"
          printf '{"type":"command_lifecycle","command_uuid":"%s","state":"completed","session_id":"%s"}\n' "$uuid" "$session"
          continue
          ;;
      esac
      printf '{"type":"user","uuid":"%s","isReplay":true,"message":{"role":"user","content":[{"type":"text","text":"%s"}]},"session_id":"%s"}\n' "$uuid" "$said" "$session"
      case " $answered " in
        *" $uuid "*) continue ;;
      esac
      answered="$answered $uuid"
      printf '{"type":"command_lifecycle","command_uuid":"%s","state":"queued","session_id":"%s"}\n' "$uuid" "$session"
      printf '{"type":"command_lifecycle","command_uuid":"%s","state":"started","session_id":"%s"}\n' "$uuid" "$session"
      printf '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"ack"}},"session_id":"%s"}\n' "$session"
      printf '{"type":"result","subtype":"success","total_cost_usd":%s,"num_turns":1,"duration_ms":5,"session_id":"%s"}\n' "$total" "$session"
      printf '{"type":"command_lifecycle","command_uuid":"%s","state":"completed","session_id":"%s"}\n' "$uuid" "$session"
      ;;
  esac
done
